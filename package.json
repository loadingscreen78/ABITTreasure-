{
  "name": "abit-tech-treasure-hunt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "test:e2e": "playwright test",
    "check:design": "node scripts/check-design.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:leaks": "node scripts/check-leaks.mjs",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:push": "node --env-file=.env.local scripts/db-push.mjs",
    "db:sql": "node scripts/build-sql.mjs",
    "load-test": "node scripts/load-test.mjs",
    "cf:build": "node scripts/cf-build.mjs",
    "cf:preview": "node scripts/cf-build.mjs && opennextjs-cloudflare preview",
    "cf:deploy": "node scripts/cf-build.mjs && opennextjs-cloudflare deploy",
    "cf:secrets": "node --env-file=.env.local scripts/cf-secrets.mjs",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run check:design && npm run build && npm run check:secrets && npm run check:leaks",
    "smoke": "node --env-file=.env.local scripts/smoke.mjs",
    "organisers": "node --env-file=.env.local scripts/create-organisers.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.18",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@opennextjs/cloudflare": "^1.20.18",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsqr": "^1.4.0",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
}
