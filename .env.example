NEXT_PUBLIC_SUPABASE_URL=            # https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # sb_publishable_...  (safe in browser ONLY because RLS is on)
SUPABASE_SECRET_KEY=                 # sb_secret_...  SERVER ONLY — never NEXT_PUBLIC_, never sent to the client
SUPABASE_JWKS_URL=                   # optional; supabase.auth.getClaims() discovers it automatically
SESSION_SECRET=                      # 32+ random bytes, signs TEAM session cookies (jose)
PUBLIC_BASE_URL=                     # short deployed URL used inside the QR codes
SECRET_WORD=                         # initial volunteer secret word (admin can change it later)
# Optional
BCRYPT_COST=5                        # 5 keeps logins under the Workers free-plan CPU limit; use 10 on Workers Paid
# Local scripts only (never read by the app)
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
